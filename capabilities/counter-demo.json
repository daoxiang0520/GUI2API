      "input_schema": {"type": "object", "properties": {"amount": {"type": "integer", "minimum": 1, "maximum": 100}}, "required": ["amount"], "additionalProperties": false},
      "output_schema": {"type": "integer"},
      "binding": {"root": "counter", "path": [], "op": "call", "member": "add", "arguments": [{"$arg": "amount"}]},
